# Copy this file to .env. Never commit .env or share your IBM API key.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
WATSONX_EMBEDDING_MODEL_ID=ibm/slate-30m-english-rtrvr
# local = TF-IDF + FAISS demonstration retrieval; watsonx = IBM Slate embeddings (requires access)
RAG_EMBEDDING_PROVIDER=local
# If Granite call fails, true returns a clearly labelled local safe draft; false shows an error.
ALLOW_OFFLINE_FALLBACK=true
